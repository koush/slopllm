{
  "version": "0.2.0",
  "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Run Qwen Chat (TSX)",
            "runtimeExecutable": "tsx",
            "console": "integratedTerminal",
            "runtimeArgs": [
                "${workspaceFolder}/src/run_qwen3_unified.ts"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Greedy 8-GPU",
            "runtimeExecutable": "tsx",
            "console": "integratedTerminal",
            "env": {
                "GLM_SKIP_MMAP_LOAD": "1"
            },
            "runtimeArgs": [
                "${workspaceFolder}/src/run_qwen3_unified.ts",
                "--gpus",
                "0,1,2,3,4,5,6,7",
                "--prompt",
                "tell me a 1000 word story",
                // "--prompt", "hi",
                "--glm51",
                "--greedy",
                // "--nvfp4",
                "--arena",
                "92",
                // "--no-cuda-graph",
                "--cp",
                "--mtp",
                "--mtp-draft-topk",
                "1,1,1",
                "--max-new-tokens",
                "2000",
            ],
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Greedy 8-GPU Small",
            "runtimeExecutable": "tsx",
            "console": "integratedTerminal",
            "env": {},
            "runtimeArgs": [
                "${workspaceFolder}/src/run_qwen3_unified.ts",
                "--gpus",
                "0,1,2,3,4,5,6,7",
                "--prompt",
                "tell me a 1000 word story",
                // "--prompt", "hi",
                "--glm51-small",
                "--greedy",
                // "--nvfp4",
                // "--arena", "92",
                // "--no-cuda-graph",
                // "--cp",
                // "--mtp",
                // "--mtp-draft-topk",
                // "1,1,1",
                "--max-new-tokens",
                "2000",
            ],
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Prefill test",
            "runtimeExecutable": "tsx",
            "console": "integratedTerminal",
            "env": {
                "GLM_SKIP_MMAP_LOAD": "1"
                // "NCCL_DEBUG": "INFO",
            },
            "runtimeArgs": [
                "${workspaceFolder}/src/run_prefill_benchmark.ts",
                "--arena", "92",
                "--cp",
                "--seq-len", "32768",
                "--chunk-size", "4096",
                "--context-len", "128000",
            ],
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
    {
      "name": "GLM: Model Loader + OpenAI Server",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--require", "tsx/cjs"],
      "program": "${workspaceFolder}/src/run_model_loader.ts",
      "cwd": "${workspaceFolder}",
      "args": [
        "--arena", "92",
        "--gpus", "0,1,2,3,4,5,6,7",
        "--cp",
        "--glm51",
        "--mtp",
        "--control-host", "127.0.0.1",
        "--control-port", "8099",
        "src/openai-server.ts",
        "--host", "0.0.0.0",
        "--port", "8000",
        "--max-pages", "2048",
        "--phased-prefill"
      ],
      "env": {
        "NCCL_P2P_LEVEL": "SYS",
        "NCCL_TOPO_FILE": "/root/chat/vllm/topo_fixed.xml"
      },
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/node_modules/**"]
    }
  ]
}
