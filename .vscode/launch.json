{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Run Qwen Chat (TSX)",
            "runtimeExecutable": "tsx",
            "console": "integratedTerminal",
            "runtimeArgs": [
                "${workspaceFolder}/src/run_qwen3_unified.ts"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Greedy 8-GPU",
            "runtimeExecutable": "tsx",
            "console": "integratedTerminal",
            "env": {
                // "NCCL_DEBUG": "INFO",
            },
            "runtimeArgs": [
                "${workspaceFolder}/src/run_qwen3_unified.ts",
                "--gpus", "0,1,2,3,4,5,6,7",
                "--prompt", "tell me a 1000 word story",
                "--glm51",
                "--greedy",
                // "--nvfp4",
                // "--no-cuda-graph",
                "--cp",
                "--mtp",
            ],
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ]
}