{
  "name": "glm",
  "version": "1.0.0",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "build:cuda": "make",
    "build:addon": "npm run build:cuda && node-gyp rebuild",
    "build:all": "npm run build:addon && npm run build",
    "test:python": "cd tests/python && pytest -v .",
    "start": "node dist/main.js",
    "start:qwen3": "node dist/run_qwen3.js",
    "start:qwen3-batch": "node dist/run_qwen3_batch.js",
    "start:qwen3-chat": "node dist/run_qwen3_unified.js",
    "start:qwen35-chat": "node dist/run_qwen3_unified.js --qwen35",
    "start:unified": "node dist/run_qwen3_unified.js",
    "dev": "tsc --watch",
    "pretest": "npm run build:all",
    "test:node": "node --test dist/test.js",
    "test:batch": "node --test dist/test_batch.js",
    "test:fp8": "node --test dist/test_fp8.js",
    "test:nccl": "node --test dist/test_nccl.js",
    "test": "npm run test:python && npm run test:node && npm run test:batch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.0.1",
    "node-addon-api": "^8.7.0"
  }
}
