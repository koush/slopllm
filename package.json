{
  "name": "glm",
  "version": "1.0.0",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "tsc",
    "build:cuda": "make -j32",
    "build:addon": "npm run build:cuda && node-gyp build",
    "build:all": "npm run build:addon && npm run build",
    "clean": "rimraf build dist",
    "configure": "node-gyp configure",
    "test:python": "cd tests/python && pytest -v .",
    "start": "node dist/src/main.js",
    "start:qwen3": "node dist/src/run_qwen3_unified.js",
    "start:qwen3-chat": "node dist/src/run_qwen3_unified.js",
    "start:qwen35-chat": "node dist/src/run_qwen3_unified.js --qwen35",
    "start:unified": "node dist/src/run_qwen3_unified.js",
    "dev": "tsc --watch",
    "pretest": "npm run build:all",
    "test:node": "node --test dist/tests/test_all.js",
    "test": "npm run test:python && npm run test:node"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.0.1",
    "node-addon-api": "^8.7.0"
  }
}
