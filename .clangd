CompileFlags:
  Add:
    - "-Inode_modules/node-addon-api"
    - "-Icsrc"
    - "-Ivendor/flashinfer/include"
    - "-Ivendor/flashinfer/3rdparty/cutlass/include"
    - "-Ivendor/flashinfer/3rdparty/cutlass/tools/util/include"
    - "-I/usr/include/node"
    - "-I/usr/local/cuda-13.3/targets/x86_64-linux/include"
    - "-std=c++17"
    - "-fPIC"
    - "--cuda-gpu-arch=sm_120a"
